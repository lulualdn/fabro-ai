{
  "name": "fabro",
  "version": "0.1.41",
  "description": "Lift off, locally.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always",
    "icons": "node scripts/build-icons.js"
  },
  "author": "UFStudios",
  "license": "UNLICENSED",
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "marked": "^18.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "axe-core": "^4.10.3",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "heroicons": "^2.2.0",
    "playwright-core": "^1.56.0",
    "ws": "^8.18.3"
  },
  "productName": "Fabro",
  "build": {
    "appId": "eu.ufstudios.fabro",
    "productName": "Fabro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "package.json",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "lulualdn",
        "repo": "fabro-ai",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fabro",
      "artifactName": "Fabro-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 180,
          "y": 215,
          "type": "file"
        },
        {
          "x": 480,
          "y": 215,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "title": "Fabro"
    },
    "protocols": [
      {
        "name": "Fabro",
        "schemes": [
          "fabro"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lulualdn/fabro-ai.git"
  }
}
